# ============================================================
# 共享基础配置（fork 定制版：极简固件）
# 策略：只保留系统基础 + LuCI 界面，业务插件一律不预装，
# 刷机后按需用 apk 安装。
# ============================================================

# Compile
# 包管理器：y = apk（OpenWrt 25.12+ 默认），n = opkg
CONFIG_USE_APK=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# LuCI Web 界面（极简固件的基础，勿删）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y

# Disable Package
CONFIG_PACKAGE_automount=n

# DEFAULT SET（ImmortalWrt 基础：时区、软件源等）
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# 以下包已按极简策略移除，刷机后按需安装：
#   luci-app-passwall / luci-app-dockerman / luci-app-samba4 /
#   luci-app-adguardhome / luci-app-mosdns / luci-app-oaf /
#   luci-app-ttyd / luci-app-upnp / luci-app-wol / luci-app-easytier /
#   luci-app-lucky / luci-app-istorex / luci-app-pbr / easytier /
#   coremark / iptables-nft / ip6tables-nft / libopenssl-legacy /
#   luci-lib-ipkg / luci-proto-wireguard / proto-bonding / luci-proto-relay
# 注意：kmod-* 内核模块包必须用同批次 kmods_*.tar.gz 归档安装，
#       不可用官方软件源（NSS 内核配置与官方不同）
