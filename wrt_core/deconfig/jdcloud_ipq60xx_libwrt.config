# ============================================================
# 京东云 雅典娜(02) / jdcloud_re-cs-02 极简固件配置（fork 定制版）
# 只构建 re-cs-02 固件，其余设备已显式关闭。
#
# 【固件策略】极简固件：仅含系统基础 + LuCI 界面 + WiFi 必需包。
# 其他软件包不预装，刷机后按需自行安装：
#   - 普通应用包：apk add <包名>（从固件自带软件源安装）
#   - 内核模块包（kmod-*）：必须从同批次发布的 kmods_*.tar.gz
#     归档安装，不可用官方软件源（NSS 内核配置与官方不同）
#
# 【自定义本固件】
# 1. 添加软件包：在本文件追加  CONFIG_PACKAGE_<包名>=y
# 2. 也可以在 GitHub Actions 的 extra_luci_packages 输入里
#    临时追加（逗号分隔，写完整包名）
# 3. 临时启用配置片段：Actions 的 add_fragments 输入填 nss
# 4. 红线（勿删）：re-cs-02 设备定义行、ipq-wifi-jdcloud_re-cs-02、
#    ath11k-firmware-qcn9074-ddwrt、kmod-ath11k-pci、
#    luci-app-athena-led —— 删了 WiFi / LED 灯控会失效
# ============================================================

# TARGET config
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=n
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="ipq-wifi-jdcloud_re-cs-02 ath11k-firmware-qcn9074-ddwrt kmod-ath11k-pci luci-app-athena-led luci-i18n-athena-led-zh-cn"
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=n
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=n
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# 显式编译开关（重要！）
# 设备包列表中的包必须有编译产物才能通过 apk 打包校验。
# 上游 DEVICE_PACKAGES 里的包会自动编译，但设备包列表字符串
# （DEVICE_EXTRA_PACKAGES）中的包必须在此显式 =y，否则会报
# "no such package"。ipq-wifi 由上游自动编译，kmod-ath11k-pci
# 已由 nss fragment 的 =m 编译。
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=y
